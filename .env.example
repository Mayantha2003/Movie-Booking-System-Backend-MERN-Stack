# Server
PORT=5001

# MongoDB
MONGO_URL=your_mongodb_connection_string_here

#JWT Token
JWT_SECRET=your_strong_secret_key_here
JWT_REFRESH_SECRET=your_refresh_secret_key_here

# Super Admin
SUPER_ADMIN_USERNAME=superadmin
SUPER_ADMIN_EMAIL=admin@example.com
SUPER_ADMIN_PASSWORD=your_strong_password_here

# Supabase
SUPABASE_URL=your_supabase_url_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here
SUPABASE_BUCKET=your_supabase_bucket_name_here  

# PayHere sandbox (fill these in when sandbox credentials and a public tunnel are available)
PAYHERE_MERCHANT_ID=PAYHERE_MERCHANT_ID
PAYHERE_MERCHANT_SECRET=PAYHERE_MERCHANT_SECRET
BACKEND_PUBLIC_URL=BACKEND_PUBLIC_URL
FRONTEND_URL=FRONTEND_URL
PAYMENT_HOLD_MINUTES=PAYMENT_HOLD_MINUTES

#Email Configuration
EMAIL_USER=EMAIL_USER
EMAIL_PASS=EMAIL_PASS
EMAIL_FROM=EMAIL_FROM
FRONTEND_URL=FRONTEND_URL

# AI Configuration
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-20b